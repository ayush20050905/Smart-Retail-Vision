<?xml version='1.0' encoding='utf-8'?>
<workbook source-platform="win" version="9.0" xmlns:user="http://www.tableausoftware.com/xml/user">
  <preferences />
  <style-theme name="clean" />
  <datasources>
    <datasource caption="RetailFlow minute metrics" inline="true" name="textscan.retailflow" version="9.0">
      <connection class="textscan" directory="../data/demo" filename="minute_metrics.csv" password="" server="">
        <relation name="minute_metrics#csv" table="[minute_metrics#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="en_US" separator=",">
            <column datatype="string" name="run_id" ordinal="0" />
            <column datatype="string" name="source_type" ordinal="1" />
            <column datatype="string" name="store_id" ordinal="2" />
            <column datatype="string" name="camera_id" ordinal="3" />
            <column datatype="datetime" name="minute" ordinal="4" />
            <column datatype="date" name="date" ordinal="5" />
            <column datatype="integer" name="hour" ordinal="6" />
            <column datatype="real" name="observed_seconds" ordinal="7" />
            <column datatype="real" name="person_seconds" ordinal="8" />
            <column datatype="real" name="queue_person_seconds" ordinal="9" />
            <column datatype="integer" name="peak_visible" ordinal="10" />
            <column datatype="integer" name="peak_queue" ordinal="11" />
            <column datatype="integer" name="entries" ordinal="12" />
            <column datatype="integer" name="exits" ordinal="13" />
            <column datatype="integer" name="queue_alerts" ordinal="14" />
            <column datatype="real" name="alert_seconds" ordinal="15" />
          </columns>
        </relation>
        <metadata-records>
          <metadata-record class="column">
            <remote-name>run_id</remote-name>
            <remote-type>129</remote-type>
            <local-name>[run_id]</local-name>
            <parent-name>[minute_metrics#csv]</parent-name>
            <remote-alias>run_id</remote-alias>
            <ordinal>0</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>source_type</remote-name>
            <remote-type>129</remote-type>
            <local-name>[source_type]</local-name>
            <parent-name>[minute_metrics#csv]</parent-name>
            <remote-alias>source_type</remote-alias>
            <ordinal>1</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>store_id</remote-name>
            <remote-type>129</remote-type>
            <local-name>[store_id]</local-name>
            <parent-name>[minute_metrics#csv]</parent-name>
            <remote-alias>store_id</remote-alias>
            <ordinal>2</ordinal>
            <local-type>string</local-type>
