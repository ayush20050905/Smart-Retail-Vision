      </connection>
      <aliases enabled="yes" />
      <column datatype="string" name="[run_id]" role="dimension" type="nominal" />
      <column datatype="string" name="[source_type]" role="dimension" type="nominal" />
      <column datatype="string" name="[store_id]" role="dimension" type="nominal" />
      <column datatype="string" name="[camera_id]" role="dimension" type="nominal" />
      <column datatype="datetime" name="[minute]" role="dimension" type="ordinal" />
      <column datatype="date" name="[date]" role="dimension" type="ordinal" />
      <column datatype="integer" name="[hour]" role="dimension" type="ordinal" />
      <column datatype="real" name="[observed_seconds]" role="measure" type="quantitative" />
      <column datatype="real" name="[person_seconds]" role="measure" type="quantitative" />
      <column datatype="real" name="[queue_person_seconds]" role="measure" type="quantitative" />
      <column datatype="integer" name="[peak_visible]" role="measure" type="quantitative" />
      <column datatype="integer" name="[peak_queue]" role="measure" type="quantitative" />
      <column datatype="integer" name="[entries]" role="measure" type="quantitative" />
      <column datatype="integer" name="[exits]" role="measure" type="quantitative" />
      <column datatype="integer" name="[queue_alerts]" role="measure" type="quantitative" />
      <column datatype="real" name="[alert_seconds]" role="measure" type="quantitative" />
      <column datatype="real" name="[Average Visible People]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF SUM([observed_seconds]) &gt; 0 THEN SUM([person_seconds])/SUM([observed_seconds]) END" />
      </column>
      <column datatype="real" name="[Average Queue Length]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF SUM([observed_seconds]) &gt; 0 THEN SUM([queue_person_seconds])/SUM([observed_seconds]) END" />
      </column>
      <column datatype="real" name="[Queue Alert Time Fraction]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF SUM([observed_seconds]) &gt; 0 THEN SUM([alert_seconds])/SUM([observed_seconds]) END" />
      </column>
      <column datatype="real" name="[Daily Entries LOD]" role="measure" type="quantitative">
        <calculation class="tableau" formula="{ FIXED [store_id], [date] : SUM([entries]) }" />
      </column>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="Entry Crossings">
      <table>
        <view>
          <datasources>
            <datasource caption="RetailFlow minute metrics" name="textscan.retailflow" />
          </datasources>
          <datasource-dependencies datasource="textscan.retailflow">
            <column datatype="string" name="[run_id]" role="dimension" type="nominal" />
            <column datatype="string" name="[source_type]" role="dimension" type="nominal" />
            <column datatype="string" name="[store_id]" role="dimension" type="nominal" />
            <column datatype="string" name="[camera_id]" role="dimension" type="nominal" />
