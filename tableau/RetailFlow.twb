            <local-type>integer</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>exits</remote-name>
            <remote-type>20</remote-type>
            <local-name>[exits]</local-name>
            <parent-name>[minute_metrics#csv]</parent-name>
            <remote-alias>exits</remote-alias>
            <ordinal>13</ordinal>
            <local-type>integer</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class="column">
            <remote-name>queue_alerts</remote-name>
            <remote-type>20</remote-type>
            <local-name>[queue_alerts]</local-name>
            <parent-name>[minute_metrics#csv]</parent-name>
            <remote-alias>queue_alerts</remote-alias>
            <ordinal>14</ordinal>
            <local-type>integer</local-type>
